<Window x:Class="TimelapseTemplateEditor.Dialog.SelectGbifCandidate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select a GBIF match" Height="500" Width="700"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Loaded="SelectGbifCandidate_OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="Message" Margin="10,10,10,10" TextWrapping="Wrap"/>

        <DataGrid Grid.Row="1" Name="CandidatesGrid"
                  Margin="10,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="CandidatesGrid_OnSelectionChanged"
                  MouseDoubleClick="CandidatesGrid_OnMouseDoubleClick">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Scientific name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                <DataGridTextColumn Header="Family" Binding="{Binding Family}"/>
                <DataGridTextColumn Header="Kingdom" Binding="{Binding Kingdom}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,10,5,10">
            <Button Name="OkButton" IsEnabled="False" IsDefault="True" Padding="10" Margin="10,0,10,0" Content="OK" Click="OkButton_OnClick"/>
            <Button IsCancel="True" Padding="10" Margin="10,0,10,0" Content="Cancel"/>
        </StackPanel>
    </Grid>
</Window>

<controls:BusyableDialogWindow x:Class="TimelapseTemplateEditor.Dialog.ImportFromFileWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:toolkit="http://timelapsewpf.toolkit/xaml"
        xmlns:controls="clr-namespace:Timelapse.Controls"
        Title="Import taxonomic information"
        Height="680" Width="1000" MinHeight="400" MinWidth="600"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Loaded="ImportFromFileWizard_OnLoaded">
    <Grid>
        <toolkit:Wizard x:Name="ImportWizard"
                        FinishButtonContent="OK"
                        FinishButtonClosesWindow="True"
                        CancelButtonClosesWindow="True"
                        HelpButtonVisibility="Collapsed">

            <!-- Explains what can be imported. Selecting a file then moves on to any of the pages below that are needed, which are set in the code. -->
            <toolkit:WizardPage x:Name="PageSelectFile"
                                PageType="Interior"
                                Title="Import from a file"
                                CanSelectNextPage="False"
                                CanFinish="False"
                                BackButtonVisibility="Collapsed"
                                NextButtonVisibility="Collapsed"
                                FinishButtonVisibility="Collapsed"
                                Background="White" HeaderBackground="WhiteSmoke">
                <StackPanel Margin="10" HorizontalAlignment="Left">
                    <TextBlock Name="SelectFileMessage" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <Button Content="Select the file" Padding="10,5" HorizontalAlignment="Left" Click="SelectFile_OnClick"
                            ToolTip="Select a recognition file (json), a Timelapse database (ddb), or a previously saved species list (json)."/>
                </StackPanel>
            </toolkit:WizardPage>

            <!-- If the list has definitions: Whether to add to or replace the list. Its buttons depend on the selection, and are set in the code. -->
            <toolkit:WizardPage x:Name="PageAddOrReplace"
                                PageType="Interior"
                                Title="Add to the existing list?"
                                Background="White" HeaderBackground="WhiteSmoke">
                <StackPanel Margin="10">
                    <TextBlock Name="AddOrReplaceMessage" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <RadioButton Name="AddToList" Content="Add to the list" FontWeight="Bold" Checked="AddOrReplace_OnChecked"
                                 ToolTip="Keep the definitions in your list, and add the file's definitions to them."/>
                    <TextBlock Name="AddToListMessage" TextWrapping="Wrap" Margin="20,3,0,15"/>
                    <RadioButton Name="ReplaceList" Content="Replace the list" FontWeight="Bold" Checked="AddOrReplace_OnChecked"
                                 ToolTip="Remove all the definitions in your list, and use the file's definitions instead."/>
                    <TextBlock Name="ReplaceListMessage" TextWrapping="Wrap" Margin="20,3,0,0"/>
                </StackPanel>
            </toolkit:WizardPage>

            <!-- If there are conflicts: What they are and what to do about them -->
            <toolkit:WizardPage x:Name="PageIntro"
                                PageType="Interior"
                                Title="Some definitions conflict"
                                CanFinish="False"
                                FinishButtonVisibility="Collapsed"
                                Background="White" HeaderBackground="WhiteSmoke">
                <TextBlock Name="IntroMessage" TextWrapping="Wrap" Margin="10"/>
            </toolkit:WizardPage>

            <!-- If there are conflicts: Choosing what to use for each one -->
            <toolkit:WizardPage x:Name="PageConflicts"
                                PageType="Interior"
                                Title="Select what to use for each conflict"
                                Description="Select what to keep in each table. Differences are in red."
                                CanSelectNextPage="False"
                                CanFinish="True"
                                NextButtonVisibility="Collapsed"
                                FinishButtonVisibility="Visible"
                                Background="White" HeaderBackground="WhiteSmoke">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Select all for" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Name="SelectAllCurrent" Content="current" Padding="10,5" Margin="0,0,10,0" Click="SelectAllCurrent_OnClick"
                                ToolTip="Select current in every conflict between your list and the file, which leaves those rows in your list as they are."/>
                        <Button Name="SelectAllNew" Content="new" Padding="10,5" Margin="0,0,10,0" Click="SelectAllNew_OnClick"
                                ToolTip="Select new in every conflict between your list and the file, which uses the file's definitions instead."/>
                        <Button Content="both" Padding="10,5" Click="SelectAllBoth_OnClick"
                                ToolTip="Select both in every conflict that offers it, which keeps both of the rows."/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="ConflictsPanel" Grid.IsSharedSizeScope="True"/>
                    </ScrollViewer>
                </Grid>
            </toolkit:WizardPage>
        </toolkit:Wizard>
        <controls:BusyCancelIndicator x:Name="BusyCancelIndicator" IsBusy="False" CancelClick="CancelAsyncOperationButton_Click"/>
    </Grid>
</controls:BusyableDialogWindow>

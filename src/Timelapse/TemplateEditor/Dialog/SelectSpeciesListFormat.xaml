<Window x:Class="TimelapseTemplateEditor.Dialog.SelectSpeciesListFormat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Populate using a species list"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Loaded="SelectSpeciesListFormat_OnLoaded">
    <StackPanel Margin="10">
        <TextBlock Name="Message" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <RadioButton Name="ScientificName" GroupName="Format" Margin="0,0,0,8" IsChecked="True" VerticalContentAlignment="Center"/>
        <RadioButton Name="CommonName" GroupName="Format" Margin="0,0,0,8" VerticalContentAlignment="Center"/>
        <RadioButton Name="ScientificThenCommonName" GroupName="Format" Margin="0,0,0,8" VerticalContentAlignment="Center"/>
        <RadioButton Name="CommonThenScientificName" GroupName="Format" Margin="0,0,0,8" VerticalContentAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="_Cancel" IsCancel="True" Padding="10" Margin="5,0,5,0" MinWidth="60"/>
            <Button Content="_OK" IsDefault="True" Padding="10" Margin="5,0,0,0" MinWidth="60" Click="OkButton_OnClick"/>
        </StackPanel>
    </StackPanel>
</Window>

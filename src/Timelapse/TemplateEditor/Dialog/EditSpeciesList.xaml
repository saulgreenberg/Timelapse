<controls:BusyableDialogWindow x:Class="TimelapseTemplateEditor.Dialog.EditSpeciesList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Timelapse.Controls"
        xmlns:local="clr-namespace:TimelapseTemplateEditor.Dialog"
        mc:Ignorable="d"
        Title="Edit a species list" Height="915" Width="1000" Loaded="EditSpeciesList_OnLoaded">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="10,10,5,5">
            <Run Text="Species list" FontWeight ="Bold" FontStyle="Italic"/> 
            is a list of taxonomic species definitions, which you can import from a file or save to a json file.<LineBreak/>
            Use it to conveniently populate a template's <Run Text="Choice"  FontWeight ="Medium" FontStyle="Italic"/> menu (e.g., a <Run Text="Species"  FontStyle="Italic"/> menu).
            <LineBreak/><LineBreak/>
            <Run Text="Scientific name*" FontWeight ="Bold" FontStyle="Italic"/> and/or <Run Text="Common name*" FontWeight ="Bold" FontStyle="Italic"/> is required for each taxonomic definition you create. 
        </TextBlock>

        <TextBlock Grid.Row="1" Margin="10,10,5,5">
            <Run Text="Species list" FontWeight ="Bold" FontSize="18"/>
            <LineBreak/>
            Select a row in the list to edit a particular taxonomic definition, or use the buttons to delete the selected definition or to add a new definition.
        </TextBlock>

        <DataGrid Grid.Row="2" Name="dataGrid"
                  Margin="10,0"
                  DataContext="{Binding Source=TaxonomicList}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly ="True"
                  CanUserSortColumns="True"
                  Sorting="DataGrid_OnSorting"
                  CanUserReorderColumns="false"
                  SelectionMode="Extended"  
                  SelectionUnit="FullRow" 
                  SelectionChanged="DataGrid_OnSelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="FontWeight"
                            Value="Bold" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Resources>
                <local:SpeciesNameConverter x:Key="SpeciesNameConverter"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="LightBlue"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                 Color="Black"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                 Color="LightBlue"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Common name*" Binding="{Binding vernacularNames[eng]}"/>
                <DataGridTextColumn Header="Scientific name*" Binding="{Binding scientificName }"/>
                <DataGridTextColumn Header="Taxon rank" Binding="{Binding taxonRank}"/>
                <DataGridTextColumn Header="Kingdom" Binding="{Binding kingdom}"/>
                <DataGridTextColumn Header="Phylum" Binding="{Binding phylum}"/>
                <DataGridTextColumn Header="Class" Binding="{Binding class_}"/>
                <DataGridTextColumn Header="Order" Binding="{Binding order}"/>
                <DataGridTextColumn Header="Family" Binding="{Binding family}"/>
                <DataGridTextColumn Header="Genus" Binding="{Binding genus}"/>
                <DataGridTextColumn Header="Species" Binding="{Binding Mode=OneWay, Converter={StaticResource SpeciesNameConverter}}" SortMemberPath="Species"/>
                <DataGridTextColumn Header="Taxon id" Binding="{Binding taxonID}" Width="*" MinWidth="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Name="ImportFromFile"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Padding="10" Margin="10,10,0,0"
                    Content="Import from file"
                    ToolTip="Add taxonomic information to the list from a recognition file, a Timelapse database, or a previously saved species list."
                    Click="ImportFromFile_OnClick"/>
            <Button Name="SaveToFile"
                    IsEnabled="False"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Padding="10" Margin="10,10,0,0"
                    Content="Save to file"
                    ToolTip="Save the current list to a json file"
                    Click="SaveToFile_OnClick"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="NewRow"  
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch" 
                    Padding="10" Margin="10,10,10,0"
                    Content="New definition" 
                    Click="NewRow_OnClick"/>
            <Button Name="DeleteRow"  
                    IsEnabled="False" 
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch" 
                    Padding="10" Margin="10,10,10,0" 
                    Content ="Delete definition"
                    Click="DeleteRow_OnClick"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Margin="10,0,5,0">
            <Run Text="Taxonomic definition editor" FontWeight ="Bold" FontSize="18"/>
            <LineBreak/>
            Type to change a field's contents. Tooltips describe what the field is for, including an example.
        </TextBlock>

        <Grid Grid.Row="5" Name="EditGrid" Margin="10">
            <Grid.Resources >
                <Style TargetType="Border" >
                    <Setter Property="Margin" Value="5,0,5,5" />
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Name ="TBCommonName"
                       HorizontalAlignment="Right" Margin="5,5,0,5"
                       FontWeight="Bold"
                       Text = "{Binding Path=CommonNameField.Label}"
                       ToolTip ="{Binding Path=CommonNameField.Tooltip}"
                       />

            <TextBlock Grid.Row="1" Grid.Column="0" 
                       Name ="TBScientificName" 
                       HorizontalAlignment="Right" Margin="5,5,0,5"
                       FontWeight="Bold"
                       Text = "{Binding Path=ScientificNameField.Label}"
                       ToolTip ="{Binding Path=ScientificNameField.Tooltip}"
                       />

            <TextBlock Grid.Row="2" Grid.Column="0" 
                       Name ="TBTaxonRank" 
                       HorizontalAlignment="Right" Margin="5,5,0,5"
                       FontWeight="Bold"
                       Text = "{Binding Path=TaxonRankField.Label}"
                       ToolTip ="{Binding Path=TaxonRankField.Tooltip}"
            />

            <TextBlock Grid.Row="3" Grid.Column="0" 
                       Name ="TBKingdom" 
                       HorizontalAlignment="Right" Margin="5,5,0,5"
                       FontWeight="Bold"
                       Text = "{Binding Path=KingdomField.Label}"
                       ToolTip ="{Binding Path=KingdomField.Tooltip}"
                       />

            <TextBlock Grid.Row="4" Grid.Column="0" 
                       Name ="TBPhylum" 
                       HorizontalAlignment="Right" Margin="5,5,0,5"
                       FontWeight="Bold"
                       Text = "{Binding Path=PhylumField.Label}"
                       ToolTip ="{Binding Path=PhylumField.Tooltip}"
            />

            <TextBlock Grid.Row="5" Grid.Column="0" 
                       Name ="TBClass" 
                       HorizontalAlignment="Right" Margin="5,5,0,5"
                       FontWeight="Bold"
                       Text = "{Binding Path=ClassField.Label}"
                       ToolTip ="{Binding Path=ClassField.Tooltip}"
            />

            <TextBlock Grid.Row="6" Grid.Column="0" 
                       Name ="TBOrder" 
                       HorizontalAlignment="Right" Margin="5,5,0,5"
                       FontWeight="Bold"
                       Text = "{Binding Path=OrderField.Label}"
                       ToolTip ="{Binding Path=OrderField.Tooltip}"
            />

            <TextBlock Grid.Row="7" Grid.Column="0" 
                       Name ="TBFamily" 
                       HorizontalAlignment="Right" Margin="5,5,0,5"
                       FontWeight="Bold"
                       Text = "{Binding Path=FamilyField.Label}"
                       ToolTip ="{Binding Path=FamilyField.Tooltip}"
            />

            <TextBlock Grid.Row="8" Grid.Column="0" 
                       Name ="TBGenus" 
                       HorizontalAlignment="Right" Margin="5,5,0,5"
                       FontWeight="Bold"
                       Text = "{Binding Path=GenusField.Label}"
                       ToolTip ="{Binding Path=GenusField.Tooltip}"
            />

            <TextBlock Grid.Row="9" Grid.Column="0" 
                       Name ="TBTaxonID" 
                       HorizontalAlignment="Right"  Margin="5,5,0,5"
                       FontWeight="Bold"
                       Text = "{Binding Path=TaxonIDField.Label}"
                       ToolTip ="{Binding Path=TaxonIDField.Tooltip}"
                       />

            <DockPanel Grid.Row="0" Grid.Column="1">
                <Button DockPanel.Dock="Right"
                        Name="GbifCommonNameLookup"
                        IsEnabled="False"
                        Margin="0,5,5,5"
                        Padding="10,0"
                        Content="Look up in GBIF"
                        ToolTip="Use the common name, in English, to fill in this definition's other fields from GBIF (gbif.org). If several taxa have that name, you can choose one. This needs an internet connection."
                        Click="GbifCommonNameLookup_OnClick"/>
                <TextBox Name ="DataFieldCommonName"
                         Margin="5,5,5,5"
                         Text=""
                         ToolTip ="{Binding Path=CommonNameField.Tooltip}"
                         TextChanged = "DataField_OnTextChanged"
                         />
            </DockPanel>
            <DockPanel Grid.Row="1" Grid.Column="1">
                <Button DockPanel.Dock="Right"
                        Name="GbifLookup"
                        IsEnabled="False"
                        Margin="0,5,5,5"
                        Padding="10,0"
                        Content="Look up in GBIF"
                        ToolTip="Use the scientific name to fill in this definition's fields from GBIF (gbif.org). This needs an internet connection."
                        Click="GbifLookup_OnClick"/>
                <TextBox Name ="DataFieldScientificName"
                         Margin="5,5,5,5"
                         Text=""
                         ToolTip ="{Binding Path=ScientificNameField.Tooltip}"
                         TextChanged = "DataField_OnTextChanged"
                         />
            </DockPanel>
            <ComboBox Grid.Row="2" Grid.Column="1" 
                      Name ="DataFieldTaxonRank" 
                      Margin="5,5,0,5"
                      HorizontalAlignment="Left" 
                      Width ="200"
                      Text =""
                      SelectedValue =""
                      ToolTip ="{Binding Path=TaxonRankField.Tooltip}"
                      SelectionChanged="DataFieldTaxonRank_OnSelectionChanged"
            >
                <ComboBoxItem>kingdom</ComboBoxItem>
                <ComboBoxItem>phylum</ComboBoxItem>
                <ComboBoxItem>class</ComboBoxItem>
                <ComboBoxItem>order</ComboBoxItem>
                <ComboBoxItem>family</ComboBoxItem>
                <ComboBoxItem>genus</ComboBoxItem>
                <ComboBoxItem>species</ComboBoxItem>
                <ComboBoxItem>subspecies</ComboBoxItem>
            </ComboBox>


            <DockPanel Grid.Row="3" Grid.Column="1">
                <Button DockPanel.Dock="Right"
                        Name="GbifKingdomLookup"
                        IsEnabled="False"
                        Margin="0,5,5,5"
                        Padding="10,0"
                        Content="Look up in GBIF"
                        ToolTip="Use the kingdom to fill in this definition's fields from GBIF (gbif.org). This needs an internet connection."
                        Click="GbifKingdomLookup_OnClick"/>
                <TextBox Name ="DataFieldKingdom"
                         Margin="5,5,5,5"
                         Text=""
                         ToolTip ="{Binding Path=KingdomField.Tooltip}"
                         TextChanged = "DataField_OnTextChanged"
                         />
            </DockPanel>

            <DockPanel Grid.Row="4" Grid.Column="1">
                <Button DockPanel.Dock="Right"
                        Name="GbifPhylumLookup"
                        IsEnabled="False"
                        Margin="0,5,5,5"
                        Padding="10,0"
                        Content="Look up in GBIF"
                        ToolTip="Use the phylum to fill in this definition's fields from GBIF (gbif.org). This needs an internet connection."
                        Click="GbifPhylumLookup_OnClick"/>
                <TextBox Name ="DataFieldPhylum"
                         Margin="5,5,5,5"
                         Text=""
                         ToolTip ="{Binding Path=PhylumField.Tooltip}"
                         TextChanged = "DataField_OnTextChanged"
                         />
            </DockPanel>
            <DockPanel Grid.Row="5" Grid.Column="1">
                <Button DockPanel.Dock="Right"
                        Name="GbifClassLookup"
                        IsEnabled="False"
                        Margin="0,5,5,5"
                        Padding="10,0"
                        Content="Look up in GBIF"
                        ToolTip="Use the class to fill in this definition's fields from GBIF (gbif.org). This needs an internet connection."
                        Click="GbifClassLookup_OnClick"/>
                <TextBox Name ="DataFieldClass"
                         Margin="5,5,5,5"
                         Text=""
                         ToolTip ="{Binding Path=ClassField.Tooltip}"
                         TextChanged = "DataField_OnTextChanged"
                         />
            </DockPanel>
            <DockPanel Grid.Row="6" Grid.Column="1">
                <Button DockPanel.Dock="Right"
                        Name="GbifOrderLookup"
                        IsEnabled="False"
                        Margin="0,5,5,5"
                        Padding="10,0"
                        Content="Look up in GBIF"
                        ToolTip="Use the order to fill in this definition's fields from GBIF (gbif.org). This needs an internet connection."
                        Click="GbifOrderLookup_OnClick"/>
                <TextBox Name ="DataFieldOrder"
                         Margin="5,5,5,5"
                         Text=""
                         ToolTip ="{Binding Path=OrderField.Tooltip}"
                         TextChanged = "DataField_OnTextChanged"
                         />
            </DockPanel>
            <DockPanel Grid.Row="7" Grid.Column="1">
                <Button DockPanel.Dock="Right"
                        Name="GbifFamilyLookup"
                        IsEnabled="False"
                        Margin="0,5,5,5"
                        Padding="10,0"
                        Content="Look up in GBIF"
                        ToolTip="Use the family to fill in this definition's fields from GBIF (gbif.org). This needs an internet connection."
                        Click="GbifFamilyLookup_OnClick"/>
                <TextBox Name ="DataFieldFamily"
                         Margin="5,5,5,5"
                         Text=""
                         ToolTip ="{Binding Path=FamilyField.Tooltip}"
                         TextChanged = "DataField_OnTextChanged"
                         />
            </DockPanel>
            <DockPanel Grid.Row="8" Grid.Column="1">
                <Button DockPanel.Dock="Right"
                        Name="GbifGenusLookup"
                        IsEnabled="False"
                        Margin="0,5,5,5"
                        Padding="10,0"
                        Content="Look up in GBIF"
                        ToolTip="Use the genus to fill in this definition's fields from GBIF (gbif.org). This needs an internet connection."
                        Click="GbifGenusLookup_OnClick"/>
                <TextBox Name ="DataFieldGenus"
                         Margin="5,5,5,5"
                         Text=""
                         ToolTip ="{Binding Path=GenusField.Tooltip}"
                         TextChanged = "DataField_OnTextChanged"
                         />
            </DockPanel>
            <TextBox Grid.Row="9" Grid.Column="1" 
                       Name ="DataFieldTaxonID" 
                       Margin="5,5,5,5"
                       Text=""
                       ToolTip ="{Binding Path=TaxonIDField.Tooltip}"
                       TextChanged = "DataField_OnTextChanged" 
                       />
            <CheckBox Grid.Row="10" Grid.Column="1"
                      Name="AppendQualifiers"
                      Margin="5,5,5,5"
                      Content="Append qualifiers (e.g., sp., indet.) to GBIF scientific names at the genus rank or higher."
                      ToolTip="Adds 'sp.' when the rank is genus, and 'indet.' when it is above genus, e.g., Ursus sp. or Ursidae indet. A common name only gets one if GBIF doesn't list a common name, so the taxon's name is used instead."/>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,10,5,10" >
            <Button Name="DoneButton"  
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch" 
                    Padding="10" Margin="10,10,10,0"
                    Content="Done" 
                    Click="Done_OnClick"/>
            <Button Name="Cancel"  
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch" 
                    Padding="10" Margin="10,10,10,0" 
                    Content ="Cancel"
                    Click="Cancel_OnClick"/>
        </StackPanel>
        <controls:BusyCancelIndicator x:Name="BusyCancelIndicator" IsBusy="False" Grid.Row="0" Grid.RowSpan="7" CancelClick="CancelAsyncOperationButton_Click"/>
    </Grid>
</controls:BusyableDialogWindow>
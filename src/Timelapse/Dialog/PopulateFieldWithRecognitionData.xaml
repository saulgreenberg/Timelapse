<controls:BusyableDialogWindow x:Class="Timelapse.Dialog.PopulateFieldWithRecognitionData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:toolkit="http://timelapsewpf.toolkit/xaml"
        xmlns:controls="clr-namespace:Timelapse.Controls"
        mc:Ignorable="d"
        Title="Populate a Field With RecognitionData" Height="890" Width="800" Loaded="Window_Loaded">
    <Grid>
        <DockPanel Grid.Row="0">
            <ScrollViewer Height ="410" VerticalAlignment="Top"  DockPanel.Dock="Top">
                <toolkit:FormattedMessageContent 
                x:Name="Message"
                 Icon="{x:Static toolkit:DialogIconType.Question}"
                 DialogTitle="Populate a data field with recognition data?"
                 What="Record recognition criteria from the highest confidence bounding box in a data field."
                 Solution="[ni] Select a data field to populate (normally [e]Note[/e] or [e]MultiLine[/e] fields, but see below).
                    [ni] Choose the recognition data to output, and its output format ([e]Example output[/e] shows the result):
                    [li 2] [e]Value only[/e] is available only when a single item is chosen, to output just its value (e.g., [i]0.987[/i]).
                    [li 2] When outputting a [e]Confidence[/e] as a value only, [e]Decimal[/e]-type data fields become available in the menu.
                    [li 2] When outputting a [e]Category[/e] as a value only, [e]Choice[/e]-type data fields become available in the menu.
                    [ni] Click [e]Populate[/e] to begin populating the data field for your selected files."
                 Result="[li] Each selected file's field is set to the chosen recognition data.
                    [li] Files with no bounding boxes have that field cleared.
                    [li] Any existing data in that field is overwritten."
                 Hint="Review the recorded recognition data, and correct it as needed. See [link:{x:Static constant:ExternalLinks.TimelapseGuideReference}|Timelapse Reference Guide] for nuances."
                 Details="Timelapse identifies the bounding box with the highest confidence, and only uses that box's recognition data.
                    [br]This means that the recognition data may not always match what you need, because:
                    [li] an image can contain multiple entities of interest, but recognition data from only one entity is used;
                    [li] an image can contain many relevant and irrelevant bounding boxes, each with its own confidence value;
                    [li] a single entity may be represented by multiple bounding boxes;
                    [li] some entities may not be detected at all, or non-entities may be erroneously detected (false positives/false negatives).
                     [br 12][b]Algorithm[/b]: For each file in the current selection, Timelapse: 
                    [ni] Retrieves the recognition data for the image
                    [ni] Determines the bounding box (if any) with the highest confidence value (if a tie, the first one is chosen),  
                    [ni] Records the selected criteria in the chosen [e]Note[/e] or [e]MultiLine[/e] data field,
                    [ni] If there is no bounding box, clears the data field for that file"
                 ShowExplanationVisibility="False" 
                />
            </ScrollViewer>

            <!--The button panel, docked at the bottom so it is never clipped-->
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="True" >
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" IsCancel="True" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Padding="10" Margin="10,10,10,10" Click="CancelButton_Click">_Cancel</Button>
                    <Button x:Name="StartDoneButton" IsDefault="True" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Padding="10" Margin="10,10,10,10"  IsEnabled="False" Click="Start_Click">_Populate</Button>
                </StackPanel>
            </DockPanel>
            <StackPanel Orientation="Vertical" DockPanel.Dock="Top" VerticalAlignment="Stretch" Margin="10">
                <Rectangle Fill="#FF868686" Height="2" Margin="0,0,0,10"/>

                <!--The primary panel containing the options, and the feedback panel that is shown if there are no Note or MultiLine fields-->
                <StackPanel Name="PrimaryPanel" Orientation="Vertical" Margin="10,0,0,10" Visibility="Visible">

                    <!--The data field selection combobox, with a note to its right (wrapping as needed) when Decimal or Choice fields are added to it-->
                    <Grid Margin="0, 5,15,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Select a data field to contain the recognition data:" VerticalAlignment="Top" FontWeight="Bold" Margin="0, 5,15,5"
                                   ToolTip="Only Notes and MultiLineText fields are listed,&#x000A;as only these can reliably hold the recognition contents.&#x000A;Decimal fields are also listed when outputting a single Confidence as a value only,&#x000A;and Choice fields when outputting a single Detection or Classification category as a value only"/>
                        <ComboBox Grid.Column="1" Name="ComboBoxSelectNoteField" Width="210" Height="30" VerticalAlignment="Top"  VerticalContentAlignment="Center"
                                  SelectionChanged="ComboBoxSelectNoteField_SelectionChanged" 
                                  ToolTip="Only Notes and MultiLineText fields are listed,&#x000A;as only these can reliably hold the recognition contents.&#x000A;Decimal fields are also listed when outputting a single Confidence as a value only,&#x000A;and Choice fields when outputting a single Detection or Classification category as a value only"/>

                        <!--Shown only when the Decimal fields are added to the data field drop-down menu-->
                        <TextBlock Grid.Column="2" Name="TextBlockDecimalFieldsNote" Foreground="#FF1F5F9E" FontStyle="Italic" TextWrapping="Wrap" VerticalAlignment="Top" Margin="15,0,0,0" Visibility="Hidden">
                            Includes <Bold>Decimal</Bold> fields as confidence is a decimal.
                        </TextBlock>

                        <!--Shown only when the Choice fields are added to the data field drop-down menu-->
                        <TextBlock Grid.Column="2" Name="TextBlockChoiceFieldsNote" Foreground="#FF1F5F9E" FontStyle="Italic" TextWrapping="Wrap" VerticalAlignment="Top" Margin="15,0,0,0" Visibility="Hidden">
                            Includes <Bold>Choice</Bold> fields as categories may match choice menu items.
                        </TextBlock>
                    </Grid>

                    <!-- The main options panel.
                         The last column takes the remaining width, so the example output spans the dialog's full (fixed) width and wraps within it,
                         rather than growing the panel as the selections change-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--The main GroupBox containing the desired data field checkboxes-->
                        <GroupBox Name="GroupBox" Grid.Row="0" Grid.Column="0"
                                  Margin="0,3,0,0" Padding="5,0,5,0" BorderThickness="1" BorderBrush="LightGray"
                                  Header= "Choose data to output" >
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30"  />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"  FontWeight="DemiBold"  Margin="0,0,10,0"
                                       Text="Bounding box:"/>
                                <CheckBox Name="CBBoundingBoxCoordinates" Click="DataToOutput_Click"  Grid.Row="0" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"
                                      Content ="Coordinates" ToolTip="The bounding box's x, y, width and height" />

                                <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="DemiBold" VerticalAlignment="Center"
                                       Text="Detection:"/>
                                <CheckBox Name="CBDetectionCategory" Click="DataToOutput_Click" Grid.Row="1" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"
                                       Content="Category" />
                                <CheckBox Name="CBDetectionConfidence" Click="DataToOutput_Click" Grid.Row="1" Grid.Column="2" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Content="Confidence" />

                                <!--The Classification row is disabled when the recognition data has no classification categories-->
                                <TextBlock Name="TextBlockClassificationLabel" Grid.Row="2" Grid.Column="0" FontWeight="DemiBold" VerticalAlignment="Center"
                                       Text="Classification:"/>
                                <CheckBox Name="CBClassificationCategory" Click="DataToOutput_Click" Grid.Row="2" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"
                                      Content="Category" />
                                <CheckBox Name="CBClassificationConfidence" Click="DataToOutput_Click" Grid.Row="2" Grid.Column="2" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"
                                      Content="Confidence" />
                            </Grid>
                        </GroupBox>

                        <!--The GroupBox containing the output format radio buttons-->
                        <GroupBox Grid.Row="0" Grid.Column="1"  Name="GroupBoxOutputFormat" Header="Output format"
                                  Margin="15,3,0,0" Padding="5,0,5,0" BorderThickness="1" BorderBrush="LightGray">
                            <!--Two columns of two formats each, to use the horizontal space-->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Row="0" Grid.Column="1" Name="RBAsFormattedJson" Click="OutputFormat_Click" Content="As formatted Json" GroupName="OutputFormat" VerticalAlignment="Center" IsChecked ="false" Margin="20, 0,10,0"
                                             ToolTip="Outputs the recognition data as a pretty-printed json structure (with line breaks)"/>
                                <RadioButton Grid.Row="1" Grid.Column="1" Name="RBAsUnformattedJson" Click="OutputFormat_Click" Content="As unformatted Json" GroupName="OutputFormat" VerticalAlignment="Center" IsChecked ="false" Margin="20, 0,10,0"
                                             ToolTip="Outputs the recognition data as a compact json structure, all on a single line"/>
                                <RadioButton Grid.Row="0" Grid.Column="0" Name="RBAsPlainText" Click="OutputFormat_Click" Content="As label:value" GroupName="OutputFormat" VerticalAlignment="Center" IsChecked ="true" Margin="10, 0,0,0"
                                             ToolTip="Outputs the recognition data as rows of plain text, each comprising a descriptive label and the recognition value"/>
                                <RadioButton Grid.Row="1" Grid.Column="0" Name="RBAsRaw" Click="OutputFormat_Click" Content="As value only (single item)" GroupName="OutputFormat" VerticalAlignment="Center" Margin="10, 0,0,0"
                                             ToolTip="Outputs only the value of the single selected recognition data, without any labels (e.g., 0.987).&#x000A;Available only when a single data checkbox is selected.&#x000A;For a Confidence, Decimal data fields can also be selected"/>
                            </Grid>
                        </GroupBox>

                        <!--The GroupBox showing an example of the output for the current selections, updated as they change-->
                        <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Name="GroupBoxExample" Header="Example output"
                                  Margin="0,10,0,0" Padding="5,0,5,5" BorderThickness="1" BorderBrush="LightGray">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Name="TextBlockExampleSource" Foreground="#FF1F5F9E" FontStyle="Italic" TextWrapping="Wrap" Margin="0,3,0,5"/>
                                <TextBox Name="TextBoxExample" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Height="110"
                                         VerticalScrollBarVisibility="Auto" Background="#FFF7F7F7" BorderBrush="LightGray"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </StackPanel>

                <!--The secondary feedback panel, shown when there are no Note or MultiLine fields-->
                <StackPanel Name="FeedbackPanel" Orientation="Vertical" Visibility="Collapsed">
                    <TextBlock Name="TextBlockFeedbackLine1" Text="No Note or MultiLine fields are available" VerticalAlignment="Center" Margin="0,5,15,5" FontWeight="Bold" />
                    <TextBlock Name="TextBlockFeedbackLine2" Text="You need to add at least one Note or MultiLine field in your template." VerticalAlignment="Center" Margin="0,5,0,5" FontWeight="Bold" />
                </StackPanel>
            </StackPanel>

        </DockPanel>
        <controls:BusyCancelIndicator x:Name="BusyCancelIndicator" IsBusy="False" Grid.Row="0" CancelClick="CancelAsyncOperationButton_Click"/>
    </Grid>
</controls:BusyableDialogWindow>

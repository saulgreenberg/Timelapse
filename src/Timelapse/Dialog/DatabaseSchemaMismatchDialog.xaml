<Window x:Class="Timelapse.Dialog.DatabaseSchemaMismatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:toolkit="clr-namespace:TimelapseWpf.Toolkit;assembly=TimelapseWpf.Toolkit"
        Title="Database and template are out of sync"
        MinHeight="420" MinWidth="700" Height="860" Width="860"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header message -->
        <toolkit:FormattedMessageContent x:Name="Message" Grid.Row="0"/>

        <!-- Scrollable action table -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="10,5,10,5">
            <Grid x:Name="ActionGrid" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- Col 0: Type -->
                    <ColumnDefinition Width="Auto"/>   <!-- Col 1: Column name -->
                    <ColumnDefinition Width="Auto"/>   <!-- Col 2: Details/info -->
                    <ColumnDefinition Width="Auto"/>   <!-- Col 3: Action label or radio Delete -->
                    <ColumnDefinition Width="Auto"/>   <!-- Col 4: Radio Rename to: -->
                    <ColumnDefinition Width="*"/>      <!-- Col 5: ComboBox -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>     <!-- Row 0: column headers -->
                </Grid.RowDefinitions>
                <!-- Column headers -->
                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" FontSize="13" Margin="0,0,20,5" VerticalAlignment="Center" Text="Type"/>
                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="Bold" FontSize="13" Margin="0,0,20,5" VerticalAlignment="Center" Text="Column"/>
                <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="Bold" FontSize="13" Margin="0,0,30,5" VerticalAlignment="Center" Text="Details"/>
                <TextBlock Grid.Row="0" Grid.Column="3" FontWeight="Bold" FontSize="13" Margin="0,0,20,5" VerticalAlignment="Center" Text="Action"/>
            </Grid>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,10,10">
            <Button x:Name="RepairButton" Content="Repair" Width="100" Padding="5,8" Margin="0,0,10,0" Click="Repair_Click"/>
            <Button x:Name="ContinueLoadingButton" Content="Continue loading" Padding="5,8" Margin="0,0,10,0"
                    Visibility="Collapsed" Click="ContinueLoading_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Padding="5,8" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

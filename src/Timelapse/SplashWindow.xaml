<Window x:Class="Timelapse.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Timelapse"
    Width="400" Height="480"
    WindowStyle="None"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False"
    Topmost="True"
    Background="Transparent"
    AllowsTransparency="True">
    <Border BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Background="#1E1E1E">
        <Border.Clip>
            <RectangleGeometry Rect="0,0,400,480" RadiusX="12" RadiusY="12"/>
        </Border.Clip>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="390"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="0" Stretch="UniformToFill" ClipToBounds="True"
                   Source="pack://application:,,/Resources/Splash/SplashBackground.jpg"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="Timelapse is loading" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="DotsText" Text="." FontSize="18" FontWeight="Bold" Foreground="White" Width="24"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
